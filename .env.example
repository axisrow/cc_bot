# Токен бота от @BotFather (обязательно)
BOT_TOKEN=123456:ABC-DEF...

# Чат, куда слать уведомления. Узнать можно командой /id у запущенного бота.
# Если пусто — уведомления не рассылаются, работают только команды.
CHAT_ID=

# Топик (вкладка) форум-группы, куда слать уведомления. Это среднее число в
# ссылке на сообщение топика: https://t.me/<group>/<MESSAGE_THREAD_ID>/<msg_id>.
# Если пусто — уведомления идут в General.
MESSAGE_THREAD_ID=

# Telegram-id админа для служебного пинга "Monitoring started" при каждом старте.
# Узнать свой id можно у @userinfobot. Если пусто — стартовый пинг не шлётся.
ADMIN_ID=

# Интервал опроса статус-страницы, секунды
POLL_INTERVAL=120

# Таймзона для отображения времени в уведомлениях (имя из IANA tz database)
DISPLAY_TIMEZONE=UTC
